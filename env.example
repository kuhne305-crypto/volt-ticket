# ============================
# VOLT TICKETS - Umgebungsvariablen
# In Railway unter diesem Service als "Variables" eintragen
# (lokal: diese Datei zu ".env" kopieren und ausfüllen)
# ============================

# Bot-Token dieses Bots aus dem Discord Developer Portal
# (eigener Bot-Account, getrennt vom VOLT ADMIN Bot)
DISCORD_TOKEN=

# Server-ID, auf dem der Bot laufen soll
GUILD_ID=

# Komma-getrennte Rollennamen, die ALLE Tickets sehen dürfen
# (Ersteller sieht sein eigenes Ticket zusätzlich immer automatisch)
STAFF_ROLE_NAMES=Admin,Moderator,Supporter

# Kategorie-Namen, in die offene/geschlossene Tickets verschoben werden
TICKETS_OPEN_CATEGORY=🎫 TICKETS
TICKETS_CLOSED_CATEGORY=🗄️ TICKET-ARCHIV

# Kanalname, in den neue Tickets geloggt werden
TICKET_LOG_CHANNEL=ticket-logs
